configuration {
    modes: [ drun, run, window ];
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    disable-history: false;
    sidebar-mode: true;
    display-drun: "󰀻 Apps";
    display-run: " Run";
    display-window: "󰕰 Windows";
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
}

@theme "tokyonight"
