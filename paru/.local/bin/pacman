#!/usr/bin/env bash
#
# pacman wrapper: redirects package management calls (install/remove) to paru,
# while delegating queries, deptests, database checks, and root executions directly to /usr/bin/pacman.
#

REAL_PACMAN="/usr/bin/pacman"
if [ ! -x "$REAL_PACMAN" ]; then
    for cand in /usr/bin/pacman /usr/local/bin/pacman /bin/pacman; do
        cand_real="$(readlink -f "$cand" 2>/dev/null || realpath "$cand" 2>/dev/null || echo "$cand")"
        self_real="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
        if [ -x "$cand" ] && [ "$cand_real" != "$self_real" ]; then
            REAL_PACMAN="$cand"
            break
        fi
    done
fi

# 1. If running as root (EUID=0), paru refuses to run. Delegate directly to real pacman.
if [ "$EUID" -eq 0 ]; then
    exec "$REAL_PACMAN" "$@"
fi

# 2. Fast-path non-modifying operations directly to real pacman (avoids wrapper overhead and pipe deadlocks)
for arg in "$@"; do
    case "$arg" in
        -[a-zA-Z]*T*|--deptest|-[a-zA-Z]*Q*|--query|-[a-zA-Z]*D*|--database|-V|--version|-h|--help)
            exec "$REAL_PACMAN" "$@"
            ;;
    esac
done

# 3. Redirect all other pacman calls to paru
exec paru "$@"
