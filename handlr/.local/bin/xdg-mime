#!/bin/sh
# xdg-mime wrapper shadowing system xdg-mime with handlr
case "$1" in
    default)
        # xdg-mime default <application.desktop> <mimetype>...
        app="$2"
        shift 2
        for mime in "$@"; do
            handlr set "$mime" "$app"
        done
        ;;
    query)
        # xdg-mime query default <mimetype>
        if [ "$2" = "default" ]; then
            exec handlr get "$3"
        elif [ "$2" = "filetype" ]; then
            exec handlr get --mimetype "$3"
        else
            exec handlr get "$@"
        fi
        ;;
    *)
        # Fall back to real xdg-mime if available (e.g. for install, uninstall)
        if [ -x /usr/bin/xdg-mime ]; then
            exec /usr/bin/xdg-mime "$@"
        fi
        exec handlr "$@"
        ;;
esac
