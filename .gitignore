# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Stow backup files
*.stowbak

# Neovim swap/undo files (though they are usually in ~/.local/state)
*.swp
*.swo

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Tmux plugins
tmux/.config/tmux/plugins/

#spotatui
spotatui/.config/spotatui/.spotify_token_cache_*.json
spotatui/.config/spotatui/streaming_cache/
spotatui/.config/spotatui/history/
spotatui/.config/spotatui/spotatui-recap.html

# Neovim
nvim/.config/nvim/*.bak
nvim/.config/nvim/*.log
nvim/.config/nvim/undo/

#beets
beets/.config/beets/spotify_token.json
beets/.config/beets/discogs_token.json
beets/.config/beets/.spotmissing-token
beets/.config/beets/state.pickle


# Gemini / Antigravity
gemini/.gemini/config/projects/
gemini/.gemini/config/.migrated


# SSH
ssh/.ssh/*
!ssh/.ssh/config

# gh
gh/.config/gh/*.log

# darktable
darktable/.config/darktable/library.db
darktable/.config/darktable/*.db-snp-*
darktable/.config/darktable/*.db-pre-*
darktable/.config/darktable/*.db-journal
darktable/.config/darktable/*.db-wal
darktable/.config/darktable/*.db-shm
darktable/.config/darktable/*.lock
darktable/.config/darktable/shortcutsrc.backup
darktable/.config/darktable/shortcutsrc.defaults
darktable/.config/darktable/shortcutsrc.edit
