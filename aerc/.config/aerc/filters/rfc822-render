#!/usr/bin/env python3
import sys
import email
from email import policy
import subprocess
import shutil
import os

def render_html(html_content):
    html_render = os.path.expanduser("~/.config/aerc/filters/html-render")
    if os.path.exists(html_render):
        proc = subprocess.Popen([html_render], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        out, _ = proc.communicate(input=html_content)
        return out
    if shutil.which("w3m"):
        proc = subprocess.Popen(["w3m", "-T", "text/html", "-dump", "-no-graph", "-o", "display_link_number=0"],
                                stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        out, _ = proc.communicate(input=html_content)
        return out
    return html_content

def main():
    raw_data = b""
    try:
        raw_data = sys.stdin.buffer.read()
        if not raw_data:
            return
        
        msg = email.message_from_bytes(raw_data, policy=policy.default)
        
        # Extract main text/html body cleanly
        body = msg.get_body(preferencelist=('plain', 'html'))
        if body:
            content_type = body.get_content_type()
            content = body.get_content()
            if content_type == 'text/html':
                rendered = render_html(content)
                sys.stdout.write(rendered)
            else:
                sys.stdout.write(content)
        else:
            payload = msg.get_payload()
            if isinstance(payload, str):
                sys.stdout.write(payload)
            elif isinstance(payload, bytes):
                sys.stdout.write(payload.decode('utf-8', errors='replace'))
                
        # List any non-body attachments neatly
        attachments = []
        for part in msg.iter_attachments():
            fn = part.get_filename() or "attachment"
            ct = part.get_content_type()
            payload = part.get_payload(decode=True)
            size = len(payload) if payload else 0
            size_str = f"{size / 1024:.1f} KB" if size > 1024 else f"{size} B"
            attachments.append(f"  📎 {fn} ({ct}, {size_str})")
            
        if attachments:
            sys.stdout.write("\n\n────────────────────────────────────────────\n")
            sys.stdout.write("Attachments:\n" + "\n".join(attachments) + "\n")
            
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)
    except Exception:
        # Fallback to raw output if parsing fails
        if raw_data:
            sys.stdout.buffer.write(raw_data)

if __name__ == '__main__':
    main()
